{
  // Cloudflare Workers static assets: the built PWA in ./dist, no server code.
  // Committed so builds never depend on Wrangler's automatic project setup.
  // "name" must match the Worker's name in the Cloudflare dashboard.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spotifywrapper",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  // Pull requests get a preview link (wrangler versions upload) to review changes.
  "preview_urls": true,
  // No Workers Logs: the app collects no telemetry (docs/SECURITY.md).
  "observability": { "enabled": false },
  // Wrangler builds the app itself, so the dashboard needs no build command.
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    // Hash routing means every real path exists; unknown paths serve index.html.
    "not_found_handling": "single-page-application",
  },
}
